# Dependencies — never commit (link: deps resolve from the DSH profile)
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Local / runtime
*.log
npm-debug.log*

# Secrets — never commit
.secrets/
*.env
.env.*
!*.env.example

# Build artifacts (this repo is a hand-checked-in source bundle; add a build dir if one is introduced)
dist/
build/
*.tsbuildinfo

# Workflow runtime state — never commit user workspace data
.dsh-workflow/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
